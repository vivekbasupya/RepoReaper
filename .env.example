# Local-only development configuration. Generate secrets using scripts/init_env.py.
DATABASE_URL=postgresql+asyncpg://reaper:local-only@postgres:5432/reaper
CHECKPOINT_URL=postgresql://reaper:local-only@postgres:5432/reaper?options=-csearch_path%3Dcheckpoints
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
RUNNER_URL=http://runner:8090
RUNNER_TOKEN=REPLACE_WITH_GENERATED_LOCAL_SECRET
SESSION_SECRET=REPLACE_WITH_GENERATED_LOCAL_SECRET
APP_ORIGIN=http://localhost:8080
ARTIFACT_ROOT=/data/artifacts
SANDBOX_GLOBAL_SLOTS=1
PUBLICATION_ENABLED=false
# Populate with scripts/pin_profiles.py after building the curated sandbox images.
PYTHON_IMAGE=REPLACE_WITH_BUILT_PROFILE_DIGEST
NODE_IMAGE=REPLACE_WITH_BUILT_PROFILE_DIGEST
