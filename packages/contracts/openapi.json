  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "verified_fix",
          "partial_verification",
          "unverified_patch",
          "not_reproduced",
          "environment_failure",
          "cancelled"
        ],
        "title": "Outcome"
      },
      "RunCreate": {
        "properties": {
          "fixture": {
            "type": "string",
            "title": "Fixture",
            "default": "python-boundary"
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "default": "Inclusive boundary excludes the maximum"
          },
          "description": {
            "type": "string",
            "maxLength": 8000,
            "title": "Description",
            "default": "The upper boundary should be included."
          },
          "fault": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fault"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RunCreate"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "queued",
          "preparing",
          "investigating",
          "waiting_execution",
          "waiting_input",
          "verifying",
          "needs_review",
          "completed",
          "cancelling",
          "cancelled",
          "failed"
        ],
        "title": "RunStatus"
      },
      "RunView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "fixture": {
            "type": "string",
            "title": "Fixture"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Outcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "base_sha": {
            "type": "string",
            "title": "Base Sha"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "graph_version": {
            "type": "string",
            "title": "Graph Version"
          },
          "latest_sequence": {
            "type": "integer",
            "title": "Latest Sequence"
          },
          "patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch"
          },
          "patch_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch Sha256"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Evidence"
          },
          "targets": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Targets"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "deterministic_fixture"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "fixture",
          "title",
          "status",
          "outcome",
          "base_sha",
          "version",
          "graph_version",
          "latest_sequence",
          "patch",
          "patch_sha256",
          "evidence",
          "targets"
        ],
        "title": "RunView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}